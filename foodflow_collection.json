                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"cliente1\",\n  \"password\": \"123456\",\n  \"nome\": \"Cliente Teste\",\n  \"email\": \"cliente@email.com\"\n}"
            },
            "url": {
