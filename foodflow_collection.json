{
  "info": {
    "name": "FoodFlow - Projeto Final DWeb II",
    "_postman_id": "foodflow-final-project",
    "description": "Collection do projeto final FoodFlow com JWT e compartilhamento automático de token",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{foodflow_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "foodflow_token",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.request.url.path.includes('login')) {",
          "    const response = pm.response.json();",
          "    pm.collectionVariables.set('foodflow_token', response.token);",
          "}"
        ]
      }
    }
  ],
  "item": [
